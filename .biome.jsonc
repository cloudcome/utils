{
  // @file biome.jsonc
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "packages/*/{src,test,scripts}/**/*",
      "*.config.{js,mjs,ts,mts}",
      "*.config-*.{js,mjs,ts,mts}",
      // 三方库文件
      "!packages/*/src/**/*.mjs"
    ]
  },
  "assist": {
    "enabled": true
  },
  // 继承 .editorconfig
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  }
}
