{
  "name": "utils",
  "version": "1.1.0",
  "private": true,
  "description": "",
  "keywords": [
    "cloudcome",
    "utils",
    "utils-browser",
    "utils-core",
    "utils-node",
    "utils-react",
    "utils-uni",
    "utils-vue"
  ],
  "homepage": "https://cloudcome.github.io/utils/",
  "license": "MIT",
  "author": "云淡然 <hi@ydr.me> (https://ydr.me/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudcome/utils.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint && oxfmt --check && pnpm -F='*' run lint",
    "lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously && oxfmt --write && pnpm -F='*' run lint",
    "build": "pnpm -F='!docs' -F='!helpers' run build",
    "test": "pnpm -F='!docs' -F='!helpers' run test",
    "test:coverage": "pnpm -F='!docs' -F='!helpers' run test:coverage",
    "docs:dev": "pnpm -F='@cloudcome/docs' run dev",
    "docs:build": "pnpm -F='@cloudcome/docs' run build",
    "docs:preview": "pnpm -F='@cloudcome/docs' run preview"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@commitlint/types": "^21.0.0",
    "@lerna-lite/cli": "^5.2.1",
    "@lerna-lite/version": "^5.2.1",
    "@types/node": "24",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.20.0",
    "taze": "^19.11.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^5.0.0",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
