{
  "name": "@cloudcome/utils-node",
  "version": "1.3.2",
  "description": "cloudcome utils for node",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "cross-env NODE_ENV=production vite build",
    "generate": "node ../helpers/bin/index.cjs generate"
  },
  "engines": {
    "node": ">=22"
  },
  "engineStrict": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./base64": {
      "types": "./dist/base64.d.ts",
      "import": "./dist/base64.mjs",
      "require": "./dist/base64.cjs"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.mjs",
      "require": "./dist/crypto.cjs"
    },
    "./jsonl": {
      "types": "./dist/jsonl.d.ts",
      "import": "./dist/jsonl.mjs",
      "require": "./dist/jsonl.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "base64": [
        "./dist/base64.d.ts"
      ],
      "crypto": [
        "./dist/crypto.d.ts"
      ],
      "jsonl": [
        "./dist/jsonl.d.ts"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
