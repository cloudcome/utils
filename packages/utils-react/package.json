{
  "name": "@cloudcome/utils-react",
  "version": "1.1.0",
  "description": "cloudcome utils for react",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "cross-env NODE_ENV=production vite build",
    "generate": "node ../helpers/bin/index.cjs generate"
  },
  "engines": {
    "node": ">=22"
  },
  "engineStrict": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {}
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
