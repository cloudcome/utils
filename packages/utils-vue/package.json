{
  "name": "@cloudcome/utils-vue",
  "version": "1.11.6",
  "description": "cloudcome utils for vue",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "cross-env NODE_ENV=production vite build",
    "generate": "node ../helpers/bin/index.cjs generate"
  },
  "engines": {
    "node": ">=22"
  },
  "engineStrict": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.mjs",
      "require": "./dist/async.cjs"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "import": "./dist/component.mjs",
      "require": "./dist/component.cjs"
    },
    "./event": {
      "types": "./dist/event.d.ts",
      "import": "./dist/event.mjs",
      "require": "./dist/event.cjs"
    },
    "./request": {
      "types": "./dist/request.d.ts",
      "import": "./dist/request.mjs",
      "require": "./dist/request.cjs"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.mjs",
      "require": "./dist/shared.cjs"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "import": "./dist/time.mjs",
      "require": "./dist/time.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "async": [
        "./dist/async.d.ts"
      ],
      "component": [
        "./dist/component.d.ts"
      ],
      "event": [
        "./dist/event.d.ts"
      ],
      "request": [
        "./dist/request.d.ts"
      ],
      "shared": [
        "./dist/shared.d.ts"
      ],
      "time": [
        "./dist/time.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@cloudcome/utils-core": "workspace:~",
    "vue": "^3.5.13",
    "vue-component-type-helpers": "^2.2.10"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6"
  }
}