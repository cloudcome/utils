{
  "name": "@cloudcome/vue-composables",
  "version": "1.3.0",
  "description": "cloudcome vue composables",
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --fix --unsafe",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "cross-env NODE_ENV=production vite build",
    "generate": "node ../helpers/bin/index.cjs generate"
  },
  "engines": {
    "node": ">=22"
  },
  "engineStrict": true,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {},
  "typesVersions": {
    "*": {}
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "url": "https://github.com/cloudcome/utils/packages/vue-composables"
  },
  "dependencies": {
    "@cloudcome/core-utils": "workspace:^",
    "vue": "^3.5.13"
  },
  "devDependencies": {

  }
}
